# Install privately as /etc/lanflux/lanflux.env, root:lanflux mode 0640.
# Replace placeholders. This is not a ready-to-deploy credential file.
LANFLUX_PUBLIC_URL=https://share.example.com
LANFLUX_ALLOWED_ORIGINS=https://share.example.com
LANFLUX_TRUSTED_HOSTS=share.example.com
LANFLUX_ROOM_TTL_SECONDS=3600
LANFLUX_PEER_IDLE_TIMEOUT_SECONDS=60
LANFLUX_MAX_ROOMS=100
LANFLUX_MAX_PEERS=100
LANFLUX_MAX_FILE_MIB=64
LANFLUX_MAX_MEMORY_MIB=128
LANFLUX_ICE_TRANSPORT_POLICY=all
LANFLUX_TURN_URLS=turns:turn.example.com:443?transport=tcp
# Required: generate a private >=32-character random secret; match coturn exactly.
# Left empty deliberately: TURN configuration fails startup until filled.
LANFLUX_TURN_SHARED_SECRET=
LANFLUX_TURN_CREDENTIAL_TTL_SECONDS=600
LANFLUX_TURN_USERNAME=
LANFLUX_TURN_CREDENTIAL=
