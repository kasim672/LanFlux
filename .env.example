# Run: python -m lanflux --lan
# Optional invitation origin override, e.g. https://share.example.com (no path).
# Leave empty for automatic physical-LAN IPv4 discovery when opened at localhost.
# Set this if discovery is unavailable, the computer has several networks, or behind a proxy.
# Use the browser-reachable port; this does not change the server's listening address.
LANFLUX_PUBLIC_URL=
# Additional trusted browser origins, comma-separated, without paths. Same origin works by default.
LANFLUX_ALLOWED_ORIGINS=
# Extra exact hostnames (no ports, paths or wildcards) for public/custom DNS hosts.
# Localhost, private/loopback IPs, unqualified LAN hostnames and .local work by default.
# PUBLIC_URL and ALLOWED_ORIGINS hosts are trusted automatically.
LANFLUX_TRUSTED_HOSTS=
LANFLUX_PEER_IDLE_TIMEOUT_SECONDS=60
LANFLUX_ROOM_TTL_SECONDS=3600
LANFLUX_MAX_ROOMS=1000
LANFLUX_MAX_PEERS=512
# Safety limits for this in-memory browser MVP. Maximums: 64 and 128 MiB.
LANFLUX_MAX_FILE_MIB=64
LANFLUX_MAX_MEMORY_MIB=128
LANFLUX_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN relays encrypted WebRTC traffic, never through the Python file server.
# Browser-visible credentials: use short-lived credentials for public deployment.
LANFLUX_TURN_URLS=
LANFLUX_TURN_USERNAME=
LANFLUX_TURN_CREDENTIAL=
# all = prefer any viable direct or relay connection; relay = force configured TURN.
LANFLUX_ICE_TRANSPORT_POLICY=all
